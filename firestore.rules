rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public portfolio content. Clients may read only.
    // Writes happen via Firebase Console or the Admin seed script.
    match /portfolio/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

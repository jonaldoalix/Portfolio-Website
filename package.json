{
  "name": "portfolio-website",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "lint:prod": "oxlint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "seed:content": "tsx scripts/seed-content.ts",
    "deploy": "npm run build && npx firebase-tools deploy --only hosting,firestore",
    "deploy:hosting": "npm run build && npx firebase-tools deploy --only hosting"
  },
  "dependencies": {
    "firebase": "^12.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "firebase-admin": "^13.6.0",
    "jsdom": "^27.0.1",
    "oxlint": "^1.71.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
